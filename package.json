{
  "name": "suntek-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run --prefix client dev",
    "dev:server": "npm run --prefix server dev",
    "build": "npm run --prefix server build && npm run --prefix client build",
    "build:client": "npm run --prefix client build",
    "build:server": "npm run --prefix server build",
    "prisma:generate": "npm run --prefix server prisma:generate",
    "prisma:migrate": "npm run --prefix server prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
